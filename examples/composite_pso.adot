digraph COMPOSITE_PSO {
    ALWAYS [module=test_funcs.cmc_func, entry_func=true_predicate]

    INIT_FUNC   [module=test_funcs.cmc_func, entry_func=pso_initialize]
    BEST_FUNC   [module=test_funcs.cmc_func, entry_func=pso_update_best]
    STEP_FUNC   [module=test_funcs.cmc_func, entry_func=pso_advance_swarm]
    SAVE_FUNC   [module=test_funcs.cmc_func, entry_func=pso_save_result]
    STOP_SELECTOR [module=test_funcs.cmc_func, entry_func=pso_stop_selector]
    PREPARE_SHARDS_FUNC [module=test_funcs.cmc_func, entry_func=pso_prepare_shard_requests]


    INIT   [predicate=ALWAYS, function=INIT_FUNC, comment="Initialize PSO swarm"]
    PREPARE_SHARDS [predicate=ALWAYS, function=PREPARE_SHARDS_FUNC, comment="Build remote C++ shard requests"]
    EVAL_0 [executor=remote_cpp, operation=pso_evaluate_shard, input_key=pso_shard_request_0, output_key=pso_shard_0]
    EVAL_1 [executor=remote_cpp, operation=pso_evaluate_shard, input_key=pso_shard_request_1, output_key=pso_shard_1]
    EVAL_2 [executor=remote_cpp, operation=pso_evaluate_shard, input_key=pso_shard_request_2, output_key=pso_shard_2]
    EVAL_3 [executor=remote_cpp, operation=pso_evaluate_shard, input_key=pso_shard_request_3, output_key=pso_shard_3]
    BEST   [predicate=ALWAYS, function=BEST_FUNC, comment="Update personal and global best"]
    STEP   [predicate=ALWAYS, function=STEP_FUNC, comment="Move swarm to next iteration"]
    SAVE   [predicate=ALWAYS, function=SAVE_FUNC, comment="Save optimization result"]

    SWARM_READY [parallelism=threading, comment="Evaluate particle shards in parallel"]
    JOIN [comment="Wait for all particle shards"]

    __BEGIN__ -> PREPARED [morphism=INIT]
    PREPARED -> SWARM_READY [morphism=PREPARE_SHARDS]
    SWARM_READY [parallelism=threading]
    SWARM_READY -> SHARD_0_DONE [morphism=EVAL_0]
    SWARM_READY -> SHARD_1_DONE [morphism=EVAL_1]
    SWARM_READY -> SHARD_2_DONE [morphism=EVAL_2]
    SWARM_READY -> SHARD_3_DONE [morphism=EVAL_3]

    SHARD_0_DONE -> JOIN
    SHARD_1_DONE -> JOIN
    SHARD_2_DONE -> JOIN
    SHARD_3_DONE -> JOIN

    JOIN -> BEST_UPDATED [morphism=BEST]
    BEST_UPDATED -> SWARM_READY, SAVED [selector=STOP_SELECTOR, morphism=(STEP, SAVE)]
    SAVED -> __END__
}
